# Bright Data Proxy / API Configuration
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_ZONE=your_brightdata_zone_name
BRIGHTDATA_ENDPOINT=https://api.brightdata.com

# Database Configuration
# DATABASE_BACKEND=sqlite # options: sqlite (default) or turso
DATABASE_PATH=parcels.db

# Turso / libSQL Configuration (Production)
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# API & Logging Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
